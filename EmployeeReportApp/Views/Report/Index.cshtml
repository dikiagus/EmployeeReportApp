@model List<EmployeeReportDto>

<h1>Employee Report</h1>

<table class="table">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Department</th>
            <th>Hire Date</th>
            <th>Salary</th>
            <th>Years of Service</th>
            <th>Bonus</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.FullName</td>
                <td>@employee.Department</td>
                <td>@employee.HireDate</td>
                <td>@employee.Salary.ToString("C")</td>
                <td>@employee.YearsOfService</td>
                <td>@employee.Bonus.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-action="ExportToExcel" class="btn btn-primary">Export to Excel</a>
    <a asp-action="ExportToPDF" class="btn btn-secondary">Export to PDF</a>
</div>